  ["claude-seo"]="https://github.com/AgriciDaniel/claude-seo.git"
  ["agentic-seo-skill"]="https://github.com/Bhanunamikaze/Agentic-SEO-Skill.git"
  ["firecrawl-skills"]="https://github.com/firecrawl/skills.git"
  ["firecrawl-mcp-server"]="https://github.com/firecrawl/firecrawl-mcp-server.git"
  ["stitch-mcp"]="https://github.com/davideast/stitch-mcp.git"
  ["stitch-mcp-server"]="https://github.com/Kargatharaakash/stitch-mcp.git"
  ["stitch-skills"]="https://github.com/google-labs-code/stitch-skills.git"
  ["arxiv-mcp-server"]="https://github.com/blazickjp/arxiv-mcp-server.git"
  ["jules-extension"]="https://github.com/gemini-cli-extensions/jules.git"
)

for dir_name in "${!UPSTREAM_REPOS[@]}"; do
  if [[ ! -d "${SKILLS_DIR}/${dir_name}" ]]; then
    echo "      -> Cloning missing upstream repo ${dir_name}..."
    git clone --depth 1 "${UPSTREAM_REPOS[$dir_name]}" "${SKILLS_DIR}/${dir_name}" >/dev/null 2>&1 || true
    rm -rf "${SKILLS_DIR}/${dir_name}/.git"
  fi
done

