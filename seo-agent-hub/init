#!/usr/bin/env bash
# ==============================================================================
# SEO Agent Hub - Minimal Declarative Initialization Wrapper (./init)
# Refactored for Universal Agent Adapter Layer:
#   1. Agent Adapter Handshake (Antigravity Remote Sessions primary, Jules sunset fallback)
#   2. Stitch MCP Universal Binding (@_davideast/stitch-mcp & google-labs-code/stitch-skills)
#   3. Pluggable Routing & Multi-Agent Discovery
#   4. Cloned Upstream Skills & SQLite State Provisioning
#   5. Observation Deck & GrowthBook Local Endpoint Launch + Script Snippet Output
# ==============================================================================
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${ROOT_DIR}/config"
STATE_DIR="${ROOT_DIR}/state"
SKILLS_DIR="${ROOT_DIR}/skills"
ADAPTERS_DIR="${ROOT_DIR}/adapters"
DB_PATH="${STATE_DIR}/seo_hub.db"
NON_INTERACTIVE=0
START_DAEMON=0

for arg in "$@"; do
  case "$arg" in
    --non-interactive) NON_INTERACTIVE=1 ;;
    --daemon) START_DAEMON=1 ;;
  esac
done

mkdir -p "${STATE_DIR}" "${STATE_DIR}/arxiv-papers" "${ROOT_DIR}/.stitch/designs" "${ROOT_DIR}/sdk/generated-pages"

if [[ -f "${ROOT_DIR}/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "${ROOT_DIR}/.env"
  set +a
fi

PRIMARY_AGENT_ADAPTER="${PRIMARY_AGENT_ADAPTER:-antigravity}"
SEO_HUB_PORT="${SEO_HUB_PORT:-4325}"
STITCH_PROJECT_ID="${STITCH_PROJECT_ID:-503366360860058565}"

echo "=================================================================="
echo "  SEO Agent Hub :: Universal Agent Adapter & MCP Initialization"
echo "=================================================================="

# ------------------------------------------------------------------------------
# Task 1: Agent Adapter Handshake (Antigravity Primary + Jules Sunset Support)
# ------------------------------------------------------------------------------
echo "[1/5] Configuring Universal Agent Adapter Layer..."

# Check Antigravity Remote Engine
if command -v antigravity >/dev/null 2>&1 || [[ -d "/opt/antigravity" ]]; then
  ANTIGRAVITY_STATUS="available"
  echo "      -> Antigravity Remote Session engine detected (/opt/antigravity)."
else
  ANTIGRAVITY_STATUS="emulated"
  echo "      -> Antigravity Remote Session engine running in user-space emulation mode."
fi

# Check Jules Sunset Status
JULES_NOTICE="Jules is scheduled for sunset. Antigravity remote sessions is the active primary engine."
if command -v jules >/dev/null 2>&1 && [[ "${NON_INTERACTIVE}" -eq 0 ]]; then
  jules auth login --provider google --export "${STATE_DIR}/jules.session.json" || true
else
  cat > "${STATE_DIR}/jules.session.json" <<EOF
{
  "adapter": "jules",
  "status": "sunsetting",
  "sunset_scheduled": true,
  "sunset_notice": "${JULES_NOTICE}",
  "fallback_target": "antigravity",
  "extension_path": "./skills/jules-extension",
  "updated_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
fi

cat > "${STATE_DIR}/agent.adapters.json" <<EOF
{
  "active_primary": "${PRIMARY_AGENT_ADAPTER}",
  "adapters": {
    "antigravity": {
      "type": "remote_session",
      "status": "active_primary",
      "sunset_scheduled": false,
      "detected": "${ANTIGRAVITY_STATUS}",
      "entrypoint": "./adapters/antigravity-adapter.mjs"
    },
    "jules": {
      "type": "cli_extension",
      "status": "sunsetting",
      "sunset_scheduled": true,
      "sunset_notice": "${JULES_NOTICE}",
      "entrypoint": "./adapters/jules-adapter.mjs"
    },
    "extensible_agents": {
      "type": "pluggable_driver",
      "status": "extensible",
      "entrypoint": "./adapters/generic-adapter.mjs"
    }
  },
  "updated_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
echo "      -> Active Primary Adapter: ${PRIMARY_AGENT_ADAPTER}"
echo "      -> Jules Status: Sunsetting (fallback to Antigravity active)"

# ------------------------------------------------------------------------------
# Task 2: Stitch MCP Universal Adapter Binding
# ------------------------------------------------------------------------------
echo "[2/5] Binding Stitch MCP server (@_davideast/stitch-mcp, Project: ${STITCH_PROJECT_ID})..."
cat > "${STATE_DIR}/stitch.binding.json" <<EOF
{
  "mcp_server": "stitch",
  "package": "@_davideast/stitch-mcp",
  "local_repo": "./skills/stitch-mcp",
  "skills_repo": "./skills/stitch-skills",
  "project_id": "${STITCH_PROJECT_ID}",
  "design_system": "Clinical Vitality",
  "baton_file": "./.stitch/next-prompt.md",
  "usage_scope": "page_and_variant_generation_only",
  "bound_adapter": "${PRIMARY_AGENT_ADAPTER}",
  "bound_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
echo "      -> Stitch MCP bound to Universal Agent Adapter interface."

# ------------------------------------------------------------------------------
# Task 3: Pluggable Routing Manifest
# ------------------------------------------------------------------------------
echo "[3/5] Generating runtime routing configuration..."
cat > "${STATE_DIR}/runtime.routing.json" <<EOF
{
  "active_adapter": "${PRIMARY_AGENT_ADAPTER}",
  "orchestrator_engine": "${PRIMARY_AGENT_ADAPTER}",
  "research_engine": "${PRIMARY_AGENT_ADAPTER}",
  "appearance_engine": "${PRIMARY_AGENT_ADAPTER}+stitch",
  "validation_engine": "${PRIMARY_AGENT_ADAPTER}+openseo",
  "sunset_fallback_engine": "antigravity",
  "updated_at": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
}
EOF
echo "      -> Runtime routing locked: ${PRIMARY_AGENT_ADAPTER} (with multi-agent failover)"

# ------------------------------------------------------------------------------
# Task 4: Cloned Skills Verification & SQLite State Provisioning
# ------------------------------------------------------------------------------
echo "[4/5] Verifying cloned upstream skill repositories & provisioning SQLite state store..."
