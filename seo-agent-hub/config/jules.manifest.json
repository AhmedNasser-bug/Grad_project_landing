{
  "$schema": "https://jules.google/schemas/v2/manifest.json",
  "project_name": "seo-agent-hub",
  "version": "2.0.0",
  "sunset_notice": "Google Jules is scheduled for sunset. This manifest delegates to config/agents.manifest.json under the Universal Agent Adapter architecture.",
  "canonical_manifest": "./config/agents.manifest.json",
  "active_adapter": "antigravity",
  "legacy_adapter": "jules",
  "state_store": {
    "driver": "sqlite",
    "database_path": "./state/seo_hub.db",
    "schema_path": "./config/sqlite.schema.sql",
    "pool_isolation": {
      "orchestrator_tier": "read_write_primary",
      "research_tier": "write_isolated",
      "validation_tier": "read_audit"
    }
  },
  "demographics": {
    "primary_testing_cohort": "18-24",
    "cohorts": [
      "18-24",
      "25-34",
      "35-44",
      "45-54",
      "55-64",
      "65+"
    ]
  },
  "agents": {
    "orchestrator": {
      "role": "Universal Core Orchestrator (via Agent Adapter)",
      "operator": "antigravity_with_jules_fallback",
      "adapter_manifest": "./config/agents.manifest.json",
      "prompt_path": "./agents/orchestrator.md",
      "skills": [
        "./skills/stitch-skills/plugins/stitch-utilities/skills/stitch-loop/SKILL.md",
        "./skills/stitch-skills/plugins/stitch-utilities/skills/site-md/SKILL.md"
      ],
      "mcp_bindings": ["sqlite", "stitch", "antigravity", "jules"],
      "can_approve_mutations": true
    },
    "research": {
      "role": "Web Reconnaissance & Academic Discovery Agent",
      "operator": "antigravity_with_jules_fallback",
      "routing_manifest": "./config/antigravity.routing.yaml",
      "prompt_path": "./agents/research.md",
      "skills": [
        "./skills/firecrawl-skills/skills/workflows/firecrawl-competitive-intel/SKILL.md",
        "./skills/firecrawl-skills/skills/workflows/firecrawl-research-papers/SKILL.md",
        "./skills/firecrawl-skills/skills/workflows/firecrawl-lead-gen/SKILL.md",
        "./skills/open-seo/.agents/skills/keyword-research/SKILL.md",
        "./skills/open-seo/.agents/skills/competitor-analysis/SKILL.md"
      ],
      "mcp_bindings": ["firecrawl", "arxiv", "sqlite"]
    },
    "validation": {
      "role": "SEO & AEO Validation Gate",
      "operator": "antigravity_with_jules_fallback",
      "prompt_path": "./agents/validation.md",
      "skills": [
        "./skills/open-seo/.agents/skills/seo-audit/SKILL.md",
        "./skills/open-seo/.agents/skills/seo-report/SKILL.md",
        "./skills/claude-seo/skills/seo-audit/SKILL.md",
        "./skills/claude-seo/skills/seo-page/SKILL.md",
        "./skills/claude-seo/skills/seo-geo/SKILL.md",
        "./skills/agentic-seo-skill/SKILL.md",
        "./skills/firecrawl-skills/skills/workflows/firecrawl-seo-audit/SKILL.md"
      ],
      "mcp_bindings": ["openseo", "sqlite"],
      "thresholds": {
        "min_openseo_score": 88,
        "min_unlighthouse_seo": 90,
        "require_llms_txt": true,
        "require_robots_txt": true
      }
    },
    "appearance": {
      "role": "Stitch Page Generation & GrowthBook Cohort Routing Agent",
      "operator": "antigravity_with_jules_fallback",
      "prompt_path": "./agents/appearance.md",
      "stitch_config": "./config/stitch.mcp.json",
      "skills": [
        "./skills/stitch-skills/plugins/stitch-utilities/skills/stitch-loop/SKILL.md",
        "./skills/stitch-skills/plugins/stitch-design/skills/generate-design/SKILL.md",
        "./skills/stitch-skills/plugins/stitch-design/skills/design-md/SKILL.md",
        "./skills/stitch-skills/plugins/stitch-design/skills/enhance-prompt/SKILL.md",
        "./skills/stitch-skills/plugins/stitch-utilities/skills/extract-static-html/SKILL.md"
      ],
      "mcp_bindings": ["stitch", "sqlite"]
    }
  }
}
