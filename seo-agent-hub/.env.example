# SEO Agent Hub - Declarative Environment Configuration (WAF SEC-01 Compliant)
# Copy this file to .env and supply your credentials. Never commit .env to version control.

# 1. Universal Agent Adapter Configuration
# Jules is scheduled for sunset. 'antigravity' is the active primary engine.
PRIMARY_AGENT_ADAPTER=antigravity
JULES_SUNSET_NOTICE_ACKNOWLEDGED=true

# Optional legacy Jules credentials (sunsetting fallback)
JULES_SESSION_TOKEN=
GOOGLE_OAUTH_ACCESS_TOKEN=

# 2. Stitch MCP Binding (Strictly for Page & Variant Generation via @_davideast/stitch-mcp)
STITCH_PROJECT_ID=503366360860058565
STITCH_API_KEY=

# 3. Research Agent MCP Keys (Firecrawl & Academic Discovery)
FIRECRAWL_API_KEY=
ARXIV_STORAGE_PATH=./state/arxiv-papers

# 4. Observation Deck & GrowthBook Local Endpoint
SEO_HUB_PORT=4325
SEO_HUB_HOST_ORIGIN=http://localhost:4321
GROWTHBOOK_CLIENT_KEY=sdk-pharos-clinical-2026
