{
  "name": "nephroedge-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NephroEdge B2B & Dual Shield — 4-Pillar Clinical Intelligence Architecture Monorepo",
  "scripts": {
    "postinstall": "npm install --prefix landing",
    "dev": "npm run dev --prefix landing",
    "build": "npm run build --prefix landing",
    "preview": "npm run preview --prefix landing",
    "astro": "npm run astro --prefix landing",
    "backend:build": "dotnet build backend/NephroEdge.B2B.slnx -maxCpuCount:1 -nodeReuse:false /p:UseSharedCompilation=false",
    "backend:test": "dotnet run --project backend/Tests_Unit/Tests_Unit.csproj --no-build",
    "desktop:dev": "npm run dev --prefix desktop/telemetry-dashboard",
    "desktop:build": "npm run build --prefix desktop/telemetry-dashboard",
    "mobile:dev": "npm run dev --prefix desktop/mobile-prototype",
    "mobile:build": "npm run build --prefix desktop/mobile-prototype",
    "telemetry:relay": "node backend/scripts/telemetry-relay.cjs",
    "android:sync": "npm run mobile:build && npx cap sync android --prefix desktop/mobile-prototype",
    "android:build": "powershell -Command \"$env:JAVA_HOME = 'C:\\Program Files\\Android\\openjdk\\jdk-21.0.8'; $env:ANDROID_HOME = \\\"$env:LOCALAPPDATA\\Android\\Sdk\\\"; cd desktop/mobile-prototype/android; .\\gradlew.bat assembleDebug; Copy-Item app/build/outputs/apk/debug/app-debug.apk ../../nephroedge-nurse-app.apk\"",
    "android:install": "powershell -Command \"& \\\"$env:LOCALAPPDATA\\Android\\Sdk\\platform-tools\\adb.exe\\\" install -r desktop/nephroedge-nurse-app.apk\"",
    "android:launch": "powershell -Command \"& \\\"$env:LOCALAPPDATA\\Android\\Sdk\\platform-tools\\adb.exe\\\" shell am start -n com.nephroedge.nurse/.MainActivity\""
  },
  "keywords": [
    "nephroedge",
    "hemodialysis",
    "clinical-decision-support",
    "dotnet-modular-monolith",
    "astro",
    "pharos-university"
  ],
  "author": "Pharos University AI Engineering Team",
  "license": "MIT"
}
