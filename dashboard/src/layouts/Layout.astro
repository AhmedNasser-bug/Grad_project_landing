---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	activePage?: 'home' | 'architecture' | 'evidence' | 'about' | 'journal';
}

const { 
	title = "The Dual Shield for Hemodialysis | Egyptian Clinical Intelligence Architecture",
	description = "An architectural framework designed to map individual hemodialysis patient risk trajectories while calculating real-time ward safety scores.",
	activePage = 'home'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{title}</title>
	<meta name="description" content={description} />
	
	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
	
	<!-- Font Awesome Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	
	<!-- Alpine.js & GSAP -->
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
	<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
</head>
<body class="relative min-h-screen flex flex-col">

	<!-- Ambient Soft Ethereal Background Glow Blobs -->
	<div style="position: fixed; top: -10%; left: 20%; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, var(--glow-teal) 0%, var(--glow-sky) 50%, transparent 80%); filter: blur(100px); pointer-events: none; opacity: 0.7; z-index: 0;"></div>
	<div style="position: fixed; bottom: -10%; right: 10%; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, var(--glow-sky) 0%, var(--glow-teal) 50%, transparent 80%); filter: blur(120px); pointer-events: none; opacity: 0.6; z-index: 0;"></div>

	<!-- GLOBAL STICKY NAVIGATION HEADER -->
	<header class="nav-header">
		<div class="nav-container">
			<!-- Brand Identifier -->
			<a href="/" style="display: flex; items-center; gap: 0.75rem; text-decoration: none;">
				<span style="width: 2.25rem; height: 2.25rem; border-radius: 50%; background-color: var(--bg-dark); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; letter-spacing: 0.05em;">
					DS
				</span>
				<div>
					<span style="font-family: var(--font-serif); font-weight: 700; font-size: 1.35rem; color: var(--text-dark); display: block; line-height: 1;">
						DUAL<span style="font-style: italic; font-weight: 400; color: var(--accent-sky); margin-left: 0.25rem;">Shield</span>
					</span>
					<span style="font-family: var(--font-mono); font-size: 0.625rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-top: 0.2rem;">Egyptian Dialysis Architecture</span>
				</div>
			</a>

			<!-- Desktop Page Links -->
			<nav class="nav-links-pill hidden md:flex">
				<a href="/" class={`nav-link-item ${activePage === 'home' ? 'active' : ''}`}>Home</a>
				<a href="/architecture" class={`nav-link-item ${activePage === 'architecture' ? 'active' : ''}`}>Architecture</a>
				<a href="/evidence" class={`nav-link-item ${activePage === 'evidence' ? 'active' : ''}`}>Evidence</a>
				<a href="/about" class={`nav-link-item ${activePage === 'about' ? 'active' : ''}`}>About</a>
				<a href="/journal" class={`nav-link-item ${activePage === 'journal' ? 'active' : ''}`}>Field Journal</a>
			</nav>

			<!-- Action Button -->
			<div style="display: flex; align-items: center; gap: 1rem;">
				<button onclick="document.getElementById('pilot-modal').classList.remove('hidden')" class="btn-primary" style="padding: 0.625rem 1.5rem; font-size: 0.75rem;">
					<span>Partner / Request Pilot</span>
					<i class="fa-solid fa-arrow-right" style="font-size: 0.625rem; color: var(--accent-sky);"></i>
				</button>
			</div>
		</div>
	</header>

	<!-- MAIN CONTENT SLOT -->
	<main style="flex-grow: 1; z-index: 10; position: relative;">
		<slot />
	</main>

	<!-- GLOBAL FOOTER -->
	<footer style="background-color: var(--bg-dark); color: #FFFFFF; margin-top: 6rem; border-top: 1px solid #1E293B; z-index: 10; position: relative;">
		<div class="container-custom" style="padding-top: 5rem; padding-bottom: 4rem;">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; border-bottom: 1px solid #1E293B; padding-bottom: 3rem;">
				<div style="grid-column: span 2;">
					<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
						<span style="width: 2rem; height: 2rem; border-radius: 50%; background-color: var(--accent-sky); color: #0F172A; display: flex; align-items: center; justify-content: center; font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem;">DS</span>
						<span style="font-family: var(--font-serif); font-weight: 700; font-size: 1.5rem; color: #FFFFFF;">DUAL<span style="font-style: italic; font-weight: 400; color: var(--accent-sky); margin-left: 0.25rem;">Shield</span></span>
					</div>
					<p style="color: #94A3B8; font-size: 0.875rem; max-width: 28rem; line-height: 1.6; margin-bottom: 1.5rem;">
						An intelligent hemodialysis decision support architecture engineered for Egyptian clinical environments. Anticipating patient risk trajectories while safeguarding ward-wide safety.
					</p>
					<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
						<span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background-color: #1E293B; color: #CBD5E1; font-family: var(--font-mono); font-size: 0.6875rem;">Pharos University in Alexandria</span>
						<span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background-color: #1E293B; color: #CBD5E1; font-family: var(--font-mono); font-size: 0.6875rem;">AY 2026/2027</span>
					</div>
				</div>

				<div>
					<h4 style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94A3B8; margin-bottom: 1rem;">Platform Pages</h4>
					<ul style="list-style: none; space-y: 0.625rem; font-size: 0.875rem; color: #CBD5E1;">
						<li><a href="/" style="color: #CBD5E1; text-decoration: none;">Home / Landing</a></li>
						<li style="margin-top: 0.5rem;"><a href="/architecture" style="color: #CBD5E1; text-decoration: none;">System Architecture</a></li>
						<li style="margin-top: 0.5rem;"><a href="/evidence" style="color: #CBD5E1; text-decoration: none;">Clinical Evidence</a></li>
						<li style="margin-top: 0.5rem;"><a href="/about" style="color: #CBD5E1; text-decoration: none;">About Team & Origin</a></li>
						<li style="margin-top: 0.5rem;"><a href="/journal" style="color: #CBD5E1; text-decoration: none;">Field Journal Build Log</a></li>
					</ul>
				</div>

				<div>
					<h4 style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #94A3B8; margin-bottom: 1rem;">Academic Supervision</h4>
					<p style="font-size: 0.875rem; color: #CBD5E1; line-height: 1.5; margin-bottom: 0.5rem;">
						<strong>Dr. Mohamed Abdou</strong><br />
						Office of the Dean<br />
						Faculty of Computer Science & AI
					</p>
					<p style="font-size: 0.75rem; color: #94A3B8; font-family: var(--font-mono); margin-top: 0.5rem;">
						Team: Aya Anwer, Ahmed Nassar, Amr Khaled, Ahmed Gamal, Abdelrahman Seif, Shaza Hany
					</p>
				</div>
			</div>

			<div style="padding-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #64748B; font-family: var(--font-mono); gap: 1rem;">
				<div>© 2026 Dual Shield Hemodialysis Architecture. All Rights Reserved.</div>
				<div style="display: flex; gap: 1.5rem;">
					<a href="/architecture" style="color: #64748B; text-decoration: none;">FHIR Specification</a>
					<a href="/journal" style="color: #64748B; text-decoration: none;">Field Survey Audit</a>
					<button onclick="document.getElementById('pilot-modal').classList.remove('hidden')" style="background: none; border: none; color: var(--accent-sky); cursor: pointer;">Request Deployment</button>
				</div>
			</div>
		</div>
	</footer>

	<!-- GLOBAL PARTNER / REQUEST PILOT MODAL DIALOGUE -->
	<div id="pilot-modal" class="hidden" style="position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 1rem; background-color: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px);">
		<div style="background-color: var(--bg-canvas); border: 1px solid var(--border-stone); border-radius: 1.5rem; max-width: 32rem; width: 100%; padding: 2rem; position: relative; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);">
			<button onclick="document.getElementById('pilot-modal').classList.add('hidden')" style="position: absolute; top: 1.5rem; right: 1.5rem; width: 2.25rem; height: 2.25rem; border-radius: 50%; background-color: #E2E8F0; border: none; cursor: pointer; font-size: 1.25rem; color: #475569;">
				&times;
			</button>

			<div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
				<span class="badge-chip badge-sky">STAGE 0 BLUEPRINT</span>
				<span style="font-family: var(--font-mono); font-size: 0.6875rem; color: #64748B;">1ST PILOT SITE OUTREACH</span>
			</div>

			<h3 style="font-family: var(--font-serif); font-size: 1.75rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.5rem;">Partner with Dual Shield</h3>
			<p style="font-size: 0.875rem; color: #475569; margin-bottom: 1.5rem; line-height: 1.5;">
				We are actively seeking our first clinical hemodialysis unit deployment site in Egypt. Hospital Directors, Nephrologists, and Engineering Donors can submit inquiries directly.
			</p>

			<form onsubmit="event.preventDefault(); alert('Inquiry sent to Pharos University Dean Office and Student Engineering Lead.'); document.getElementById('pilot-modal').classList.add('hidden');" style="display: flex; flex-direction: column; gap: 1rem;">
				<div>
					<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Your Name & Role</label>
					<input type="text" required placeholder="e.g. Dr. Sherif Hassan, Unit Director" style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid #CBD5E1; background-color: #FFFFFF; font-size: 0.875rem; outline: none;">
				</div>
				<div>
					<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Institution / Dialysis Center</label>
					<input type="text" required placeholder="Hospital or Dialysis Center Name" style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid #CBD5E1; background-color: #FFFFFF; font-size: 0.875rem; outline: none;">
				</div>
				<div>
					<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Email / WhatsApp Contact</label>
					<input type="email" required placeholder="contact@hospital.eg" style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid #CBD5E1; background-color: #FFFFFF; font-size: 0.875rem; outline: none;">
				</div>
				<div>
					<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600; color: #334155; margin-bottom: 0.25rem;">Inquiry Type</label>
					<select style="width: 100%; padding: 0.75rem 1rem; border-radius: 0.75rem; border: 1px solid #CBD5E1; background-color: #FFFFFF; font-size: 0.875rem; outline: none;">
						<option>Clinical Deployment Partner (Hospital Unit)</option>
						<option>Hardware Telemetry Sensor Donor</option>
						<option>Academic / Engineering Collaborator</option>
					</select>
				</div>
				<button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 0.5rem;">
					Submit Deployment Inquiry &rarr;
				</button>
			</form>
		</div>
	</div>

</body>
</html>
