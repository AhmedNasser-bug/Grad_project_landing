---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Partner & Request Pilot Deployment | Dual Shield" activePage="home">

	<!-- HEADER & OUTREACH HERO -->
	<section class="section-padding" style="position: relative; overflow: hidden; z-index: 10; padding-top: 4rem; padding-bottom: 4rem;">
		<div class="container-custom">
			
			<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem;">
				<span class="badge-chip badge-sky">STAGE 0 BLUEPRINT</span>
				<span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-light);">1ST PILOT SITE OUTREACH</span>
			</div>

			<h1 class="hero-title" style="max-width: 52rem;">
				Partner With <span style="font-style: italic; font-weight: 400; color: var(--accent-sky);">Dual Shield</span>.
				<span style="display: block; font-weight: 300; color: #334155; margin-top: 0.25rem;">Request a Clinical Deployment Pilot.</span>
			</h1>

			<p class="hero-subtitle" style="max-width: 44rem;">
				We are actively seeking our first clinical hemodialysis unit deployment site in Egypt. Hospital Directors, Nephrologists, and Hardware Donors can submit deployment inquiries directly below.
			</p>
		</div>
	</section>

	<!-- FORM CONTAINER & INQUIRY SECTION -->
	<section class="section-padding" style="background-color: var(--bg-canvas-muted); border-top: 1px solid var(--border-stone); border-bottom: 1px solid var(--border-stone); position: relative; z-index: 10;">
		<div class="container-custom">
			<div style="max-width: 42rem; margin: 0 auto;">
				
				<div class="card-white" style="padding: 3rem; box-shadow: 0 20px 40px rgba(0,0,0,0.04);">
					<h2 style="font-family: var(--font-serif); font-size: 2rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.5rem;">
						Deployment Inquiry Form
					</h2>
					<p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 2rem; font-weight: 300; line-height: 1.6;">
						Direct outreach to Pharos University Faculty of Computer Science & AI Dean Office and Student Engineering Team.
					</p>

					<form onsubmit="event.preventDefault(); alert('Inquiry successfully sent to Pharos University Dean Office & Lead Engineer.'); window.location.href='/';" style="display: flex; flex-direction: column; gap: 1.5rem;">
						
						<div>
							<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 0.5rem;">
								Your Full Name & Title *
							</label>
							<input type="text" required placeholder="e.g. Dr. Sherif Hassan, Unit Director" style="width: 100%; padding: 0.875rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-stone); background-color: #FFFFFF; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-dark); outline: none;">
						</div>

						<div>
							<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 0.5rem;">
								Institution / Dialysis Center Name *
							</label>
							<input type="text" required placeholder="Hospital or Dialysis Center Name (e.g. Alexandria Main University Hospital)" style="width: 100%; padding: 0.875rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-stone); background-color: #FFFFFF; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-dark); outline: none;">
						</div>

						<div>
							<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 0.5rem;">
								Email Address / Direct WhatsApp *
							</label>
							<input type="email" required placeholder="contact@hospital.eg" style="width: 100%; padding: 0.875rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-stone); background-color: #FFFFFF; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-dark); outline: none;">
						</div>

						<div>
							<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 0.5rem;">
								Inquiry & Collaboration Type *
							</label>
							<select style="width: 100%; padding: 0.875rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-stone); background-color: #FFFFFF; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-dark); outline: none;">
								<option>Clinical Deployment Partner (Hospital Dialysis Unit)</option>
								<option>Hardware Telemetry Sensor Donor (Load-cell / Fingerprint)</option>
								<option>Academic / Medical Research Collaborator</option>
							</select>
						</div>

						<div>
							<label style="display: block; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dark); margin-bottom: 0.5rem;">
								Unit Capacity & Additional Details
							</label>
							<textarea rows="4" placeholder="Number of active dialysis beds, current paper charting workflow, or equipment specifications..." style="width: 100%; padding: 0.875rem 1.25rem; border-radius: 0.75rem; border: 1px solid var(--border-stone); background-color: #FFFFFF; font-family: var(--font-sans); font-size: 0.875rem; color: var(--text-dark); outline: none; resize: vertical;"></textarea>
						</div>

						<button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 1.125rem; margin-top: 1rem;">
							<span>Submit Deployment Inquiry &rarr;</span>
						</button>

					</form>
				</div>

			</div>
		</div>
	</section>

</Layout>
