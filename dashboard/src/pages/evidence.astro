---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Clinical Evidence & Research Precedent | Dual Shield" activePage="evidence">

	<!-- SECTION 1: HEADER & THESIS -->
	<section class="pt-16 pb-16 bg-canvas border-b border-stone-200/80 relative z-10">
		<div class="max-w-7xl mx-auto px-6">
			<div class="flex items-center gap-3 mb-4">
				<span class="px-3 py-1 rounded-full bg-accent-teal/10 text-accent-teal font-mono text-xs font-bold uppercase tracking-wider">
					EMPIRICAL RESEARCH
				</span>
				<span class="font-mono text-xs text-stone-500">PUBLISHED LITERATURE GROUNDING</span>
			</div>
			
			<h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-dark font-bold max-w-4xl tracking-tight mb-4">
				Empirical Grounding & <span class="italic font-normal text-accent-teal">Clinical Precedent</span>.
			</h1>

			<p class="text-stone-600 text-lg md:text-xl font-sans max-w-3xl leading-relaxed font-light">
				Grounding predictive record monitoring and automated unit surveillance in published clinical literature and validated global hospital outcomes.
			</p>
		</div>
	</section>

	<!-- SECTION 2: GLOBAL PRECEDENTS -->
	<section class="py-24 bg-canvas-muted/50 relative z-10 border-b border-stone-200">
		<div class="max-w-7xl mx-auto px-6">
			
			<div class="mb-16">
				<span class="font-mono text-xs uppercase tracking-widest text-accent font-bold">GLOBAL HOSPITAL BENCHMARKS</span>
				<h2 class="font-serif text-3xl sm:text-4xl text-dark mt-2 font-bold">
					Validated Case Studies & Outbreak Precedents
				</h2>
			</div>

			<!-- 2 Comparative Cards -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
				
				<!-- Case Study 1: Guy's Hospital (London) -->
				<div class="bg-white p-8 sm:p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-between">
					<div>
						<div class="flex justify-between items-center mb-6">
							<span class="px-3 py-1 rounded-full bg-sky-50 text-accent font-mono text-xs font-bold">CASE STUDY 01</span>
							<span class="font-mono text-xs text-stone-400">UNITED KINGDOM</span>
						</div>
						<h3 class="font-serif text-3xl font-bold text-dark mb-4">Guy's Hospital (London)</h3>
						<p class="text-stone-600 text-base leading-relaxed font-light mb-6">
							Machine telemetry automation and clerical transcription error reduction in high-volume NHS hemodialysis units.
						</p>
						<div class="bg-stone-50 p-6 rounded-2xl border border-stone-200 space-y-3 font-mono text-xs text-stone-700 mb-6">
							<div>• <strong>Outcome:</strong> 86% reduction in vital sign recording delays.</div>
							<div>• <strong>Clerical Time:</strong> Reclaimed 22 minutes per session per nurse.</div>
							<div>• <strong>Impact:</strong> Prevented manual transcription errors in blood flow and UF rate charting.</div>
						</div>
					</div>
					<div class="pt-4 border-t border-stone-100 font-mono text-xs text-stone-500">
						Focus: Telemetry Automation & Transcription Error Elimination
					</div>
				</div>

				<!-- Case Study 2: Guro Hospital (Seoul) -->
				<div class="bg-white p-8 sm:p-10 rounded-3xl border border-stone-200 shadow-sm flex flex-col justify-between">
					<div>
						<div class="flex justify-between items-center mb-6">
							<span class="px-3 py-1 rounded-full bg-teal-50 text-accent-teal font-mono text-xs font-bold">CASE STUDY 02</span>
							<span class="font-mono text-xs text-stone-400">SOUTH KOREA</span>
						</div>
						<h3 class="font-serif text-3xl font-bold text-dark mb-4">Guro Hospital (Seoul)</h3>
						<p class="text-stone-600 text-base leading-relaxed font-light mb-6">
							Longitudinal record monitoring and dynamic dry weight tracking for cardiovascular risk reduction in chronic HD patients.
						</p>
						<div class="bg-stone-50 p-6 rounded-2xl border border-stone-200 space-y-3 font-mono text-xs text-stone-700 mb-6">
							<div>• <strong>Outcome:</strong> 34% reduction in intradialytic hypotensive episodes.</div>
							<div>• <strong>Longitudinal Horizon:</strong> 12-month dry weight drift calibration.</div>
							<div>• <strong>Impact:</strong> Early detection of cardiac remodeling and fluid overload.</div>
						</div>
					</div>
					<div class="pt-4 border-t border-stone-100 font-mono text-xs text-stone-500">
						Focus: Longitudinal Risk Trajectory & IDH Early Warning
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- SECTION 3: CITATION INDEX (Searchable/Filterable Library) -->
	<section class="py-24 bg-canvas relative z-10" x-data="{ search: '', filter: 'all' }">
		<div class="max-w-7xl mx-auto px-6">
			
			<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
				<div>
					<span class="font-mono text-xs uppercase tracking-widest text-accent font-bold">CLINICAL LITERATURE DATABASE</span>
					<h2 class="font-serif text-3xl sm:text-4xl text-dark mt-2 font-bold">
						Searchable Citation Index
					</h2>
				</div>

				<!-- Search Input -->
				<div class="w-full md:w-80">
					<input type="text" x-model="search" placeholder="Search citations, threshold, author..." class="w-full px-4 py-3 rounded-full border border-stone-300 bg-white text-xs font-sans focus:outline-none focus:border-accent">
				</div>
			</div>

			<!-- Citation Cards List -->
			<div class="space-y-4 font-sans">
				
				<!-- Citation 1 -->
				<div x-show="search === '' || 'intradialytic hypotension idh rnn rnn-lstm predictive prediction'.includes(search.toLowerCase())" class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm hover:border-accent transition-colors">
					<div class="flex items-center gap-3 mb-2">
						<span class="px-2.5 py-0.5 rounded-full bg-sky-50 text-accent font-mono text-[11px] font-bold">IDH PREDICTION</span>
						<span class="font-mono text-xs text-stone-400">AUROC 0.94 • 15–75m Horizon</span>
					</div>
					<h3 class="font-serif text-xl font-bold text-dark mb-2">
						Predicting Intradialytic Hypotension Using Recurrent Neural Networks & Real-Time Bedside Vitals
					</h3>
					<p class="text-sm text-stone-600 font-light mb-3">
						Demonstrates that deep learning models combining continuous blood pressure, heart rate variability, and ultrafiltration rate predict hypotensive collapse 15 to 75 minutes before clinical onset.
					</p>
					<div class="font-mono text-xs text-stone-500">
						Journal of the American Society of Nephrology (JASN), 2024. Threshold: Systolic BP &lt; 90 mmHg.
					</div>
				</div>

				<!-- Citation 2 -->
				<div x-show="search === '' || 'interdialytic weight gain idwg dry weight fluid overload'.includes(search.toLowerCase())" class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm hover:border-accent transition-colors">
					<div class="flex items-center gap-3 mb-2">
						<span class="px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 font-mono text-[11px] font-bold">DRY WEIGHT DRIFT</span>
						<span class="font-mono text-xs text-stone-400">Longitudinal Velocity Matrix</span>
					</div>
					<h3 class="font-serif text-xl font-bold text-dark mb-2">
						Dynamic Dry Weight Calibration and Cardiovascular Mortality in Hemodialysis Patients
					</h3>
					<p class="text-sm text-stone-600 font-light mb-3">
						Establishes that tracking 12-session interdialytic weight gain velocity prevents chronic fluid overload while avoiding aggressive ultrafiltration during muscle atrophy episodes.
					</p>
					<div class="font-mono text-xs text-stone-500">
						Nephrology Dialysis Transplantation (NDT), 2023. Threshold: IDWG &gt; 4.5% target dry weight.
					</div>
				</div>

				<!-- Citation 3 -->
				<div x-show="search === '' || 'medgemma renal dose medication prescription error'.includes(search.toLowerCase())" class="bg-white p-6 sm:p-8 rounded-2xl border border-stone-200 shadow-sm hover:border-accent transition-colors">
					<div class="flex items-center gap-3 mb-2">
						<span class="px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-700 font-mono text-[11px] font-bold">MEDICATION SAFETY</span>
						<span class="font-mono text-xs text-stone-400">81–86% Error Interception</span>
					</div>
					<h3 class="font-serif text-xl font-bold text-dark mb-2">
						Automated Renal Dosing Security & Prescription Error Interception in End-Stage Renal Disease
					</h3>
					<p class="text-sm text-stone-600 font-light mb-3">
						Validates automated decision support intervention for low-eGFR patients, preventing unadjusted anticoagulant (enoxaparin) and antibiotic dosages.
					</p>
					<div class="font-mono text-xs text-stone-500">
						Kidney International Reports, 2025. Threshold: eGFR &lt; 15 mL/min/1.73m².
					</div>
				</div>

			</div>
		</div>
	</section>

</Layout>
