---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Dual Shield for Hemodialysis | Egyptian Clinical Intelligence Architecture" activePage="home">

	<!-- SECTION 1: HERO VIEWPORT (The Dual Shield Pitch) -->
	<section class="section-padding" style="position: relative; overflow: hidden; z-index: 10; padding-top: 4rem; padding-bottom: 6rem;">
		<div class="container-custom">
			
			<!-- Status & Truth Badges -->
			<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-bottom: 2rem;">
				<span class="badge-chip badge-sky">
					<span style="width: 0.5rem; height: 0.5rem; border-radius: 50%; background-color: var(--accent-sky);"></span>
					Blueprint & Field Survey Stage
				</span>
				<span class="badge-chip badge-teal">
					<i class="fa-solid fa-hospital-user" style="font-size: 0.625rem;"></i>
					Seeking 1st Clinical Partner
				</span>
				<span class="badge-chip badge-stone">
					HL7 FHIR Architecture
				</span>
			</div>

			<!-- Main Heading (Virtual Wellbeing Hub Inspo: Editorial Serif & Italic Typography) -->
			<div style="max-width: 64rem; margin-bottom: 2.5rem;">
				<h1 class="hero-title">
					The <span style="font-style: italic; font-weight: 400; color: var(--accent-sky);">Dual Shield</span> for Hemodialysis.
					<span style="display: block; margin-top: 0.5rem; font-weight: 300; color: #334155;">Anticipating <span style="font-style: italic; font-weight: 400; color: var(--accent-teal);">Patient Risk</span>.</span>
					<span style="display: block; font-weight: 700; color: var(--text-dark);">Safeguarding the <span style="font-style: italic; font-weight: 600;">Ward</span>.</span>
				</h1>

				<p class="hero-subtitle">
					Beyond record-keeping: an architectural framework designed to map individual patient risk trajectories while calculating real-time ward safety scores to catch complications before they happen.
				</p>
			</div>

			<!-- Hero Action Buttons -->
			<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 4rem;">
				<a href="#dual-shield-pillars" class="btn-primary">
					<span>Explore the Dual Shield</span>
					<i class="fa-solid fa-arrow-down" style="color: var(--accent-sky);"></i>
				</a>
				<a href="/journal" class="btn-secondary">
					<span>Read the Field Journal</span>
					<i class="fa-solid fa-book-open" style="color: var(--text-light);"></i>
				</a>
			</div>

			<!-- Visual Canvas Backplate: Telemetry Node Mockup -->
			<div class="card-white" style="padding: 2.5rem; box-shadow: 0 20px 40px rgba(0,0,0,0.06);">
				<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-stone); padding-bottom: 1.5rem; margin-bottom: 2rem; gap: 1rem;">
					<div>
						<div style="font-family: var(--font-mono); font-size: 0.6875rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700;">REAL-TIME SHIELD OBSERVABILITY</div>
						<div style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--text-dark); margin-top: 0.25rem;">Ward Telemetry & Individual Patient Baseline</div>
					</div>
					<div style="display: flex; align-items: center; gap: 0.75rem;">
						<span style="padding: 0.375rem 0.875rem; border-radius: 9999px; background-color: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 600;">
							● 12 Bed Stations Connected
						</span>
						<span style="padding: 0.375rem 0.875rem; border-radius: 9999px; background-color: #F0F9FF; color: #0369A1; border: 1px solid #BAE6FD; font-family: var(--font-mono); font-size: 0.75rem;">
							Ward Safety: 98.4 / 100
						</span>
					</div>
				</div>

				<!-- Dual Stream Interactive Visualization Cards -->
				<div class="grid-2">
					<!-- Per-Patient Live Stream -->
					<div style="padding: 1.5rem; border-radius: 1rem; background-color: var(--bg-canvas-muted); border: 1px solid var(--border-stone);">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
							<span style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--accent-sky); text-transform: uppercase;">PER-PATIENT SHIELD // STATION #04</span>
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-light);">Bed 04 • Ahmed M.</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.75rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-stone);">
								<span style="color: var(--text-muted);">Dynamic Dry Weight Trajectory:</span>
								<span style="font-weight: 700; color: var(--text-dark);">72.4 kg (-0.2 kg drift)</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-stone);">
								<span style="color: var(--text-muted);">Intradialytic Hypotension (IDH) Risk:</span>
								<span style="font-weight: 700; color: var(--accent-emerald);">LOW (0.12 Prob @ t+45m)</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem;">
								<span style="color: var(--text-muted);">Ultrafiltration Rate (UFR):</span>
								<span style="font-weight: 700; color: var(--text-dark);">10.2 mL/kg/h</span>
							</div>
						</div>
					</div>

					<!-- Per-Unit Ward Quality Stream -->
					<div style="padding: 1.5rem; border-radius: 1rem; background-color: var(--bg-canvas-muted); border: 1px solid var(--border-stone);">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
							<span style="font-family: var(--font-mono); font-size: 0.75rem; font-weight: 700; color: var(--accent-teal); text-transform: uppercase;">PER-UNIT SHIELD // WARD-WIDE</span>
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-light);">Alexandria Unit A</span>
						</div>
						<div style="display: flex; flex-direction: column; gap: 0.75rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-stone);">
								<span style="color: var(--text-muted);">Water Treatment Loop Conductivity:</span>
								<span style="font-weight: 700; color: var(--accent-emerald);">14.1 mS/cm (Optimal)</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--border-stone);">
								<span style="color: var(--text-muted);">Dialysate pH Balance (All Beds):</span>
								<span style="font-weight: 700; color: var(--text-dark);">7.38 pH</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; font-family: var(--font-mono); font-size: 0.75rem;">
								<span style="color: var(--text-muted);">Cross-Station Anomaly Detector:</span>
								<span style="font-weight: 700; color: var(--accent-emerald);">0 Systemic Shifts Detected</span>
							</div>
						</div>
					</div>
				</div>
			</div>

		</div>
	</section>

	<!-- SECTION 2: THE CORE USP (Per-Patient vs. Per-Unit Dual Shield) -->
	<section id="dual-shield-pillars" class="section-padding" style="background-color: rgba(239, 239, 234, 0.5); border-top: 1px solid var(--border-stone); border-bottom: 1px solid var(--border-stone); position: relative; z-index: 10;">
		<div class="container-custom">
			<div style="text-align: center; max-width: 48rem; margin: 0 auto 4rem;">
				<span style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-sky); font-weight: 700;">THE CORE USP</span>
				<h2 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); color: var(--text-dark); margin-top: 0.5rem; font-weight: 700;">
					Two Interlocked Shields. <span style="font-style: italic; font-weight: 400; color: var(--text-muted);">One Clinical Platform.</span>
				</h2>
				<p style="color: var(--text-muted); font-size: 1.125rem; margin-top: 1rem; font-weight: 300; line-height: 1.6;">
					Traditional software focuses purely on record archiving. Dual Shield provides simultaneous real-time vigilance for individual collapses and ward-wide equipment shifts.
				</p>
			</div>

			<!-- Split-Canvas 2 Pillars -->
			<div class="grid-2">
				
				<!-- Left Pillar: Per-Patient Risk Profile -->
				<div class="card-white" style="display: flex; flex-direction: column; justify-content: space-between;">
					<div>
						<div style="width: 3.5rem; height: 3.5rem; border-radius: 1rem; background-color: #F0F9FF; color: var(--accent-sky); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
							<i class="fa-solid fa-user-shield"></i>
						</div>
						<div style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-sky); font-weight: 700; margin-bottom: 0.5rem;">LEFT PILLAR</div>
						<h3 style="font-family: var(--font-serif); font-size: 1.875rem; font-weight: 700; color: var(--text-dark); margin-bottom: 1rem;">The Per-Patient Risk Profile</h3>
						<p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; font-weight: 300; margin-bottom: 2rem;">
							Designed to track individual baseline shifts, calculate dynamic dry weight trajectories, and predict Intradialytic Hypotension (IDH) 15–75 minutes before a patient collapses.
						</p>

						<ul style="list-style: none; space-y: 1rem; font-size: 0.875rem; color: #334155; margin-bottom: 2rem;">
							<li style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-sky); margin-top: 0.25rem;"></i>
								<span><strong>Intradialytic Hypotension Early Warning:</strong> RNN models alerting nurses before systolic drop occurs.</span>
							</li>
							<li style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-sky); margin-top: 0.25rem;"></i>
								<span><strong>Dynamic Dry Weight Recalibration:</strong> Detecting fluid overload vs muscle atrophy across sequential sessions.</span>
							</li>
							<li style="display: flex; align-items: flex-start; gap: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-sky); margin-top: 0.25rem;"></i>
								<span><strong>MedGemma Prescription Interception:</strong> Catching unadjusted renal medication dosages before administration.</span>
							</li>
						</ul>
					</div>

					<div style="padding-top: 1.5rem; border-top: 1px solid var(--border-stone); display: flex; align-items: center; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-light);">
						<span>FOCUS: INDIVIDUAL SAFETY</span>
						<a href="/architecture" style="color: var(--accent-sky); font-weight: 700; text-decoration: none;">View FHIR Specs &rarr;</a>
					</div>
				</div>

				<!-- Right Pillar: Per-Unit Quality Score -->
				<div class="card-white" style="display: flex; flex-direction: column; justify-content: space-between;">
					<div>
						<div style="width: 3.5rem; height: 3.5rem; border-radius: 1rem; background-color: #CCFBF1; color: var(--accent-teal); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: 700; margin-bottom: 2rem;">
							<i class="fa-solid fa-building-shield"></i>
						</div>
						<div style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-teal); font-weight: 700; margin-bottom: 0.5rem;">RIGHT PILLAR</div>
						<h3 style="font-family: var(--font-serif); font-size: 1.875rem; font-weight: 700; color: var(--text-dark); margin-bottom: 1rem;">The Per-Unit Quality Score</h3>
						<p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; font-weight: 300; margin-bottom: 2rem;">
							A ward-level shield that monitors collective telemetry across all active beds to flag electrolyte drops, water purification failures, and equipment defects before widespread harm occurs.
						</p>

						<ul style="list-style: none; space-y: 1rem; font-size: 0.875rem; color: #334155; margin-bottom: 2rem;">
							<li style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-teal); margin-top: 0.25rem;"></i>
								<span><strong>Cross-Station Anomaly Detector:</strong> Catching simultaneous vital shifts across multiple stations.</span>
							</li>
							<li style="display: flex; align-items: flex-start; gap: 0.75rem; margin-bottom: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-teal); margin-top: 0.25rem;"></i>
								<span><strong>Water Treatment Loop Guard:</strong> Continuous conductivity and chloramine surveillance replacing manual paper logs.</span>
							</li>
							<li style="display: flex; align-items: flex-start; gap: 0.75rem;">
								<i class="fa-solid fa-check" style="color: var(--accent-teal); margin-top: 0.25rem;"></i>
								<span><strong>Equipment Defect Isolation:</strong> Identifying dialyzer membrane degradation before patient exposure.</span>
							</li>
						</ul>
					</div>

					<div style="padding-top: 1.5rem; border-top: 1px solid var(--border-stone); display: flex; align-items: center; justify-content: space-between; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-light);">
						<span>FOCUS: WARD-WIDE PROTECTION</span>
						<a href="/architecture" style="color: var(--accent-teal); font-weight: 700; text-decoration: none;">View Ward Specs &rarr;</a>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- SECTION 3: THE UNMONITORED REALITY (Scrollytelling Split-Screen) -->
	<section class="section-padding" style="position: relative; z-index: 10;">
		<div class="container-custom">
			
			<div style="margin-bottom: 4rem;">
				<span style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-rose); font-weight: 700;">FIELD SURVEY EVIDENCE</span>
				<h2 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); color: var(--text-dark); margin-top: 0.5rem; font-weight: 700; max-width: 48rem;">
					The Unmonitored Reality: <span style="font-style: italic; font-weight: 400; color: var(--text-muted);">Paper Charts vs. Digital Vigilance</span>
				</h2>
			</div>

			<!-- Scrollytelling Split Grid -->
			<div class="grid-2" style="align-items: start;">
				
				<!-- Left Column: Text Narrative (2 Real Failure Modes) -->
				<div style="display: flex; flex-direction: column; gap: 3rem;">
					
					<!-- Failure Mode 1 -->
					<div class="card-white" style="position: relative;">
						<div style="width: 2rem; height: 2rem; border-radius: 50%; background-color: #FFE4E6; color: var(--accent-rose); font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
							01
						</div>
						<h3 style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.75rem;">Failure Mode 1: The Silent Ward Failure</h3>
						<p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; font-weight: 300; margin-bottom: 1rem;">
							How unrecognized mineral drops spread across multiple patients when logs remain trapped on separate physical paper charts.
						</p>
						<div style="font-size: 0.75rem; color: #475569; font-family: var(--font-mono); line-height: 1.5; background-color: var(--bg-canvas-muted); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--border-stone);">
							<strong>Field Audit Finding:</strong> In unassisted paper units, a water purification failure or chloramine leak can affect 6–10 beds simultaneously before any individual chart indicates an anomaly.
						</div>
					</div>

					<!-- Failure Mode 2 -->
					<div class="card-white" style="position: relative;">
						<div style="width: 2rem; height: 2rem; border-radius: 50%; background-color: #FFE4E6; color: var(--accent-rose); font-family: var(--font-mono); font-weight: 700; font-size: 0.75rem; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem;">
							02
						</div>
						<h3 style="font-family: var(--font-serif); font-size: 1.5rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.75rem;">Failure Mode 2: The Human Blindspot</h3>
						<p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; font-weight: 300; margin-bottom: 1rem;">
							How nurse fatigue and high patient-to-nurse ratios (up to 1:6 in Egyptian public units) cause subtle, critical vital drops to slip past unassisted eyes.
						</p>
						<div style="font-size: 0.75rem; color: #475569; font-family: var(--font-mono); line-height: 1.5; background-color: var(--bg-canvas-muted); padding: 1rem; border-radius: 0.75rem; border: 1px solid var(--border-stone);">
							<strong>Field Audit Finding:</strong> Nurses spend an average of 25 minutes per 4-hour session filling physical flowsheets by hand—time taken directly away from bedside patient observation.
						</div>
					</div>

				</div>

				<!-- Right Column: Visual Scrubbing Warning Cards -->
				<div style="position: sticky; top: 7rem; display: flex; flex-direction: column; gap: 1.5rem;">
					
					<!-- Warning State Card -->
					<div class="card-dark" style="position: relative;">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: #FB7185; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">
								<i class="fa-solid fa-triangle-exclamation" style="margin-right: 0.25rem;"></i> UNMONITORED PAPER STATE
							</span>
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: #94A3B8;">TRADITIONAL UNIT</span>
						</div>

						<div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem;">
							<div style="background-color: rgba(15, 23, 42, 0.9); padding: 1rem; border-radius: 0.75rem; border: 1px solid #334155; font-family: var(--font-mono); font-size: 0.75rem;">
								<div style="color: #94A3B8;">PAPER VITAL LOG ENTRY:</div>
								<div style="color: #E2E8F0; margin-top: 0.25rem;">10:15 AM — BP 110/70 (Handwritten on paper)</div>
								<div style="color: #FB7185; margin-top: 0.25rem;">STATUS: Unchecked until 11:15 AM rounds (60m delay)</div>
							</div>
							<div style="background-color: rgba(15, 23, 42, 0.9); padding: 1rem; border-radius: 0.75rem; border: 1px solid #334155; font-family: var(--font-mono); font-size: 0.75rem;">
								<div style="color: #94A3B8;">CROSS-BED WATER SURVEILLANCE:</div>
								<div style="color: #FB7185; margin-top: 0.25rem;">NO AUTOMATED TELEMETRY — Manual chlorine strip test missing.</div>
							</div>
						</div>

						<div style="padding-top: 1rem; border-top: 1px solid #334155; font-size: 0.75rem; color: #94A3B8; font-family: var(--font-mono); display: flex; justify-content: space-between;">
							<span>NURSE LOAD: 6 BEDS / NURSE</span>
							<span style="color: #FB7185; font-weight: 700;">RISK EXPOSURE HIGH</span>
						</div>
					</div>

					<!-- Transition to Clean Digital Shield Card -->
					<div style="background: linear-gradient(135deg, #032B45 0%, #0F172A 100%); color: #FFFFFF; padding: 2rem; border-radius: 1.5rem; border: 1px solid rgba(14, 165, 233, 0.3); box-shadow: 0 10px 30px rgba(0,0,0,0.2);">
						<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: #38BDF8; font-weight: 700; text-transform: uppercase;">
								<i class="fa-solid fa-shield-halved" style="margin-right: 0.25rem;"></i> DUAL SHIELD ACTIVE STATE
							</span>
							<span style="font-family: var(--font-mono); font-size: 0.75rem; color: #34D399;">PROTECTED</span>
						</div>

						<div style="display: flex; flex-direction: column; gap: 0.75rem; font-family: var(--font-mono); font-size: 0.75rem;">
							<div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(14, 165, 233, 0.2);">
								<span style="color: #BAE6FD;">Continuous Bedside Sensor:</span>
								<span style="color: #34D399; font-weight: 700;">Streaming @ 60 FPS</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.5rem; border-bottom: 1px solid rgba(14, 165, 233, 0.2);">
								<span style="color: #BAE6FD;">IDH Early Warning Horizon:</span>
								<span style="color: #34D399; font-weight: 700;">Alert Triggered @ t-30m</span>
							</div>
							<div style="display: flex; justify-content: space-between; align-items: center;">
								<span style="color: #BAE6FD;">Ward Quality Index:</span>
								<span style="color: #34D399; font-weight: 700;">Safe (0 Anomaly Signals)</span>
							</div>
						</div>
					</div>

				</div>

			</div>
		</div>
	</section>

	<!-- SECTION 4: FIELD SURVEY REALITY METRICS -->
	<section class="section-padding" style="background-color: var(--bg-dark); color: #FFFFFF; border-top: 1px solid #1E293B; border-bottom: 1px solid #1E293B; position: relative; z-index: 10;">
		<div class="container-custom">
			
			<div style="text-align: center; max-width: 48rem; margin: 0 auto 4rem;">
				<span style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent-sky); font-weight: 700;">EMPIRICAL DATA GROUNDING</span>
				<h2 style="font-family: var(--font-serif); font-size: clamp(2rem, 4vw, 3rem); color: #FFFFFF; margin-top: 0.5rem; font-weight: 700;">
					Field Survey Reality Metrics
				</h2>
				<p style="color: #94A3B8; font-size: 1rem; margin-top: 0.75rem; font-weight: 300;">
					Grounded strictly in direct field survey observations across Egyptian hospital hemodialysis units.
				</p>
			</div>

