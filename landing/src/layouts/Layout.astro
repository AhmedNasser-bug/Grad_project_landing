---
import '../styles/global.css';
import ClinicalResonanceLoader from '../components/ClinicalResonanceLoader.astro';

interface Props {
	title: string;
	description?: string;
	activePage?: 'home' | 'architecture' | 'evidence' | 'about' | 'journal' | 'bmc';
}

const { 
	title = "NephroGuard | Clinical Intelligence & Workflow Architecture",
	description = "Research-proven dialysis units decision support and risk prediction system engineered for Egyptian hemodialysis clinics.",
	activePage = 'home'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="theme-color" content="#0B2545" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" type="image/png" href="/landing-ref/assets/nephroguard-emblem-circle.png" />
	<title>{title}</title>
	<meta name="description" content={description} />
	
	<!-- Google Fonts: Poppins (Brand Book Primary Typeface) & JetBrains Mono -->
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Poppins:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
	
	<!-- Font Awesome Icons -->
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
	
	<!-- Alpine.js & Local Vendored GSAP -->
	<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
	<script is:inline src="/landing-ref/vendor/gsap.min.js"></script>
	<script is:inline src="/landing-ref/vendor/ScrollTrigger.min.js"></script>
</head>
<body class="relative min-h-screen flex flex-col">

	<!-- ═══ CLINICAL RESONANCE PRELOADER ═══ -->
	<ClinicalResonanceLoader />

	<!-- Ambient Soft Ethereal Background Glow Blobs -->
	<div style="position: fixed; top: -10%; left: 20%; width: 600px; height: 600px; border-radius: 50%; background: radial-gradient(circle, var(--glow-teal) 0%, var(--glow-sky) 50%, transparent 80%); filter: blur(100px); pointer-events: none; opacity: 0.7; z-index: 0;"></div>
	<div style="position: fixed; bottom: -10%; right: 10%; width: 500px; height: 500px; border-radius: 50%; background: radial-gradient(circle, var(--glow-sky) 0%, var(--glow-teal) 50%, transparent 80%); filter: blur(120px); pointer-events: none; opacity: 0.6; z-index: 0;"></div>

	<!-- GLOBAL STICKY NAVIGATION HEADER -->
	<header class="nav-header" x-data="{ mobileOpen: false }">
		<div class="nav-container">
			<!-- Brand Identifier (min-width >= 152px per Brand Book) -->
			<a href="/" style="display: flex; align-items: center; gap: 0.75rem; min-width: 168px; text-decoration: none;">
				<span style="width: 2.375rem; height: 2.375rem; border-radius: 50%; background-color: #FFFFFF; border: 1.5px solid #00A896; display: flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto;">
					<img src="/landing-ref/assets/nephroguard-logo.png" alt="" width="24" height="27" style="object-fit: contain; display: block;" />
				</span>
				<div>
					<span style="font-family: var(--font-sans); font-weight: 700; font-size: 1.2rem; color: var(--text-dark); display: block; line-height: 1.05; letter-spacing: -0.02em;">
						Nephro<span style="color: var(--accent-teal-deep);">Guard</span>
					</span>
					<span style="font-family: var(--font-mono); font-size: 0.625rem; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-top: 0.2rem;">Dialysis CDSS Architecture</span>
				</div>
			</a>

			<!-- Desktop Page Links -->
			<nav class="nav-links-pill hidden md:flex">
				<a href="/" class={`nav-link-item ${activePage === 'home' ? 'active' : ''}`}>Home</a>
				<a href="/architecture" class={`nav-link-item ${activePage === 'architecture' ? 'active' : ''}`}>Architecture</a>
				<a href="/evidence" class={`nav-link-item ${activePage === 'evidence' ? 'active' : ''}`}>Evidence</a>
				<a href="/bmc" class={`nav-link-item ${activePage === 'bmc' ? 'active' : ''}`}>Business Canvas</a>
				<a href="/about" class={`nav-link-item ${activePage === 'about' ? 'active' : ''}`}>About</a>
				<a href="/journal" class={`nav-link-item ${activePage === 'journal' ? 'active' : ''}`}>Field Journal</a>
			</nav>

			<!-- Action Button & Mobile Menu Toggle -->
			<div style="display: flex; align-items: center; gap: 0.75rem;">
				<a href="/partner" class="btn-primary" style="padding: 0.625rem 1.25rem; font-size: 0.75rem;">
					<span class="hidden sm:inline">Partner / Request Pilot</span>
					<span class="sm:hidden">Partner</span>
					<span aria-hidden="true" style="color: #5FE2D3; font-weight: 700;">→</span>
				</a>

				<!-- Mobile Hamburger Toggle -->
				<button id="mobile-toggle-btn" @click="mobileOpen = !mobileOpen" class="mobile-toggle-btn" aria-label="Toggle Menu">
					<svg id="hamburger-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Dropdown Menu Drawer -->
		<div id="mobile-menu-drawer" x-show="mobileOpen" x-cloak x-transition class="mobile-menu-drawer md:hidden">
			<div style="display: flex; flex-direction: column; gap: 0.5rem;">
				<a href="/" class={`nav-link-item ${activePage === 'home' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">Home / Landing</a>
				<a href="/architecture" class={`nav-link-item ${activePage === 'architecture' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">System Architecture</a>
				<a href="/evidence" class={`nav-link-item ${activePage === 'evidence' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">Clinical Evidence</a>
				<a href="/bmc" class={`nav-link-item ${activePage === 'bmc' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">Business Model Canvas</a>
				<a href="/about" class={`nav-link-item ${activePage === 'about' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">About Team & Origin</a>
				<a href="/journal" class={`nav-link-item ${activePage === 'journal' ? 'active' : ''}`} style="padding: 0.75rem 1rem; border-radius: 0.75rem;">Field Journal Build Log</a>
			</div>
		</div>
	</header>

	<script is:inline>
		// Vanilla JS fallback for instant, robust mobile menu toggling
		document.addEventListener('DOMContentLoaded', () => {
			const toggleBtn = document.getElementById('mobile-toggle-btn');
			const drawer = document.getElementById('mobile-menu-drawer');
			const icon = document.getElementById('hamburger-icon');
			
			if (toggleBtn && drawer) {
				toggleBtn.addEventListener('click', () => {
					const isHidden = drawer.style.display === 'none' || getComputedStyle(drawer).display === 'none';
					if (isHidden) {
						drawer.style.setProperty('display', 'block', 'important');
						if (icon) icon.innerHTML = '<path d="M6 6l12 12M18 6l-12 12" />';
					} else {
						drawer.style.setProperty('display', 'none', 'important');
						if (icon) icon.innerHTML = '<path d="M4 7h16M4 12h16M4 17h16" />';
					}
				});
			}
		});
	</script>

	<!-- MAIN CONTENT SLOT -->
	<main style="flex-grow: 1; z-index: 10; position: relative;">
		<slot />
	</main>

	<!-- GLOBAL FOOTER -->
	<footer style="background-color: var(--bg-dark); color: #FFFFFF; margin-top: 6rem; border-top: 1px solid #1D3C63; z-index: 10; position: relative;">
		<div class="container-custom" style="padding-top: 5rem; padding-bottom: 4rem;">
			<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 3rem; border-bottom: 1px solid #1D3C63; padding-bottom: 3rem;">
				<div style="grid-column: span 2;">
					<div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem; min-width: 170px;">
						<span style="width: 2.375rem; height: 2.375rem; border-radius: 50%; background-color: #FFFFFF; border: 1.5px solid #00A896; display: flex; align-items: center; justify-content: center; overflow: hidden; flex: 0 0 auto;">
							<img src="/landing-ref/assets/nephroguard-logo.png" alt="" width="24" height="27" style="object-fit: contain; display: block;" />
						</span>
						<span style="font-family: var(--font-sans); font-weight: 700; font-size: 1.4rem; color: #FFFFFF; letter-spacing: -0.02em;">Nephro<span style="color: #4DD8C8;">Guard</span></span>
					</div>
					<p style="color: #B6C7D8; font-size: 0.875rem; max-width: 28rem; line-height: 1.6; margin-bottom: 1.5rem;">
						Research-proven dialysis units decision support and risk prediction system engineered for offline ward reliability across Egyptian clinics.
					</p>
					<div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
						<span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background-color: #134074; color: #F4F7F6; font-family: var(--font-mono); font-size: 0.6875rem;">Pharos University in Alexandria</span>
						<span style="padding: 0.25rem 0.75rem; border-radius: 9999px; background-color: #134074; color: #F4F7F6; font-family: var(--font-mono); font-size: 0.6875rem;">AY 2026/2027</span>
					</div>
				</div>

				<div>
					<h4 style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8FB2D9; margin-bottom: 1rem;">Platform Pages</h4>
					<ul style="list-style: none; space-y: 0.625rem; font-size: 0.875rem; color: #DCE5E3;">
						<li><a href="/" style="color: #DCE5E3; text-decoration: none;">Home / Landing</a></li>
						<li style="margin-top: 0.5rem;"><a href="/#pricing" style="color: #DCE5E3; text-decoration: none;">Pricing &amp; Licensing</a></li>
						<li style="margin-top: 0.5rem;"><a href="/architecture" style="color: #DCE5E3; text-decoration: none;">System Architecture</a></li>
						<li style="margin-top: 0.5rem;"><a href="/evidence" style="color: #DCE5E3; text-decoration: none;">Clinical Evidence</a></li>
						<li style="margin-top: 0.5rem;"><a href="/about" style="color: #DCE5E3; text-decoration: none;">About Team & Origin</a></li>
						<li style="margin-top: 0.5rem;"><a href="/journal" style="color: #DCE5E3; text-decoration: none;">Field Journal Build Log</a></li>
					</ul>
				</div>

				<div>
					<h4 style="font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8FB2D9; margin-bottom: 1rem;">Academic Supervision</h4>
					<p style="font-size: 0.875rem; color: #DCE5E3; line-height: 1.5; margin-bottom: 0.5rem;">
						<strong>Dr. Mohamed Abdou</strong><br />
						Office of the Dean<br />
						Faculty of Computer Science & AI
					</p>
					<p style="font-size: 0.75rem; color: #8FB2D9; font-family: var(--font-mono); margin-top: 0.5rem;">
						Team: Aya Anwer, Ahmed Nassar, Amr Khaled, Ahmed Gamal, Abdelrahman Seif, Shaza Hany
					</p>
				</div>
			</div>

			<div style="padding-top: 2rem; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; font-size: 0.75rem; color: #8FB2D9; font-family: var(--font-mono); gap: 1rem;">
				<div>© 2026 NephroGuard — Dialysis Decision Support System. All Rights Reserved.</div>
				<div style="display: flex; gap: 1.5rem;">
					<a href="/architecture" style="color: #8FB2D9; text-decoration: none;">FHIR Specification</a>
					<a href="/bmc" style="color: #8FB2D9; text-decoration: none;">Business Model Canvas</a>
					<a href="/partner" style="color: #5FE2D3; text-decoration: none;">Request Deployment</a>
				</div>
			</div>
		</div>
	</footer>

</body>
</html>
